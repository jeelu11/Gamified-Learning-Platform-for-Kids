{
  "name": "eduplay-backend",
  "version": "1.0.0",
  "description": "EduPlay - Gamified Learning Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --watchAll=false",
    "test:integration": "jest --testPathPattern=integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:seed": "ts-node scripts/seedDatabase.ts",
    "db:migrate": "ts-node scripts/migrate.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^6.0.1",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.14.3",
    "dotenv": "^16.0.3",
    "nodemailer": "^6.9.1",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.8.2",
    "@sentry/node": "^7.37.1",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.14.6",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/cors": "^2.8.13",
    "@types/nodemailer": "^6.4.7",
    "@types/multer": "^1.4.7",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.9.4",
    "@types/jest": "^29.4.0",
    "@types/supertest": "^2.0.12",
    "typescript": "^4.9.5",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "jest": "^29.4.3",
    "ts-jest": "^29.0.5",
    "supertest": "^6.3.3",
    "eslint": "^8.35.0",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}